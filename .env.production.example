# Copy this file to .env.production on the server and replace the examples.
# VITE_* values are compiled into the browser application and are public.
# Never put a Supabase service-role or secret key in this file.
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=sb_publishable_replace_me

# Keep localhost when a reverse proxy such as Caddy or Nginx provides HTTPS.
READYOPS_BIND_ADDRESS=127.0.0.1
READYOPS_PORT=8080
